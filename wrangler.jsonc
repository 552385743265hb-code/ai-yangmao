{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-yangmao",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 网站页面（静态资源）；/api/* 先交给 Worker
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-yangmao", "database_id": "41f11fe0-342f-405d-b598-a0572edabceb", "migrations_dir": "migrations" }
  ],
  "routes": [{ "pattern": "ai-yangmao.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
